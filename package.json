{
  "name": "scraphold",
  "version": "1.0.0",
  "description": "锈土据点 SCRAPHOLD - browser wasteland defense game",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.sim.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node --import tsx src/headless/cli.ts",
    "balance": "node --import tsx src/headless/balance.ts",
    "trace": "node --import tsx src/headless/trace.ts",
    "e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "preact": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
